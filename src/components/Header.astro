---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import FutureLink from "./FutureLink.astro";
import { channels, navItems, otherCities, FUTURE_NOTE } from "../data/clinic";
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="#top" aria-label="Vidnova Clinic — на початок сторінки">
      <Logo class="brand-logo" title="Vidnova Clinic" />
    </a>
    <div class="switches" aria-label="Місто і мова">
      <FutureLink note={FUTURE_NOTE} class="switch">Львів</FutureLink>
      <FutureLink note={FUTURE_NOTE} class="switch">Ua</FutureLink>
    </div>
    <nav class="nav-desktop" aria-label="Розділи сторінки" data-rec="UX-R010">
      <ul>
        {navItems.map((n) => <li><a href={n.href} class="nav-link">{n.label}</a></li>)}
      </ul>
    </nav>
    <a class="header-phone tnum" href={channels.phone.href} data-rec="UX-R001,SE-R004,MA-R005,GA-R007">{channels.phone.label}</a>
    <a class="btn btn--primary header-book" href="#contacts" data-book aria-haspopup="dialog" data-rec="UX-R002,MA-R006,GA-R008">Записатися</a>
    <a class="icon-btn header-call" href={channels.phone.href} data-rec="UX-R001,SE-R004,MA-R005,GA-R007">
      <Icon name="phone" /><span class="visually-hidden">Зателефонувати</span>
    </a>
    <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" /><span class="visually-hidden">Меню</span>
    </button>
  </div>
  <div class="mobile-menu" id="mobile-menu" hidden data-menu>
    <div class="container mobile-menu__inner">
      <nav aria-label="Розділи сторінки (мобільне меню)">
        <ul class="mm-nav">
          {navItems.map((n) => <li><a href={n.href} class="mm-link" data-menu-close>{n.label}</a></li>)}
        </ul>
      </nav>
      <ul class="mm-channels">
        <li><a class="mm-channel tnum" href={channels.phone.href}><Icon name="phone" />{channels.phone.label}</a></li>
        <li><a class="mm-channel" href={channels.viber.href}><Icon name="chat" />Написати у Viber</a></li>
        <li><a class="mm-channel" href={channels.telegram.href}><Icon name="send" />Telegram-бот</a></li>
      </ul>
      <div class="mm-future">
        <p class="mm-future__title">Інші міста й мова</p>
        <ul>
          {otherCities.map((c) => <li><FutureLink note={FUTURE_NOTE}>{c}</FutureLink></li>)}
          <li><FutureLink note={FUTURE_NOTE}>Ru</FutureLink></li>
        </ul>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--color-bg); }
  .site-header::after {
    content: ""; position: absolute; inset: auto 0 0 0; height: 1px; background: var(--color-border);
    opacity: 0; transition: opacity var(--dur-fast) var(--ease-out);
  }
  .site-header.is-scrolled::after, .site-header.menu-open::after { opacity: 1; }
  .header-inner { display: flex; align-items: center; gap: var(--s-3); height: var(--header-h); }
  .brand { display: inline-flex; align-items: center; min-height: var(--tap); color: var(--color-accent); flex: none; }
  .brand :global(.brand-logo) { width: 132px; height: auto; }
  .switches { display: none; gap: var(--s-2); font-size: var(--fs-sm); }
  .switches :global(.future-link) { min-height: 32px; }
  .nav-desktop { display: none; margin-inline: auto; }
  .nav-desktop ul { display: flex; gap: clamp(1rem, 0.2rem + 1.1vw, 1.75rem); }
  .nav-link {
    position: relative; display: inline-flex; align-items: center; min-height: var(--tap);
    font-size: 0.9375rem; font-weight: 500; text-decoration: none; color: var(--color-text); white-space: nowrap;
  }
  .nav-link::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 8px; height: 1.5px; background: var(--color-accent);
    transform: scaleX(0); transform-origin: left; transition: transform var(--dur-fast) var(--ease-out);
  }
  .nav-link:hover { color: var(--color-accent); }
  .nav-link:hover::after, .nav-link:focus-visible::after { transform: scaleX(1); }
  .header-phone {
    display: none; margin-left: auto; font-weight: 600; font-size: 1rem; text-decoration: none; white-space: nowrap;
    min-height: var(--tap); align-items: center;
  }
  .header-phone:hover { color: var(--color-accent); }
  .header-book { display: none; min-height: 44px; padding-inline: var(--s-3); font-size: 1rem; }
  .icon-btn {
    display: inline-grid; place-items: center; width: var(--tap); height: var(--tap); padding: 0;
    border: 0; border-radius: var(--radius); background: transparent; color: var(--color-text); cursor: pointer;
  }
  .icon-btn:hover { color: var(--color-accent); background: var(--color-surface); }
  .header-call { margin-left: auto; color: var(--color-accent); }
  .menu-toggle :global(.i-close) { display: none; }
  .menu-toggle[aria-expanded="true"] :global(.i-open) { display: none; }
  .menu-toggle[aria-expanded="true"] :global(.i-close) { display: block; }

  @media (min-width: 768px) {
    .brand :global(.brand-logo) { width: 150px; }
    .header-call { display: none; }
    .header-phone { display: inline-flex; }
    .header-book { display: inline-flex; }
  }
  @media (min-width: 1200px) {
    .switches { display: flex; }
    .nav-desktop { display: block; }
    .header-phone { margin-left: 0; }
    .menu-toggle { display: none; }
  }

  .mobile-menu {
    position: fixed; inset: var(--header-h) 0 0 0; background: var(--color-bg); overflow-y: auto; overscroll-behavior: contain;
    animation: menu-in 240ms var(--ease-out);
  }
  .mobile-menu[hidden] { display: none; }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
  .mobile-menu__inner { display: grid; gap: var(--s-6); padding-block: var(--s-4) var(--s-8); }
  .mm-nav { display: grid; }
  .mm-link {
    display: flex; align-items: center; min-height: 56px; border-bottom: 1px solid var(--color-border);
    font-family: var(--font-display); font-size: var(--fs-lead); text-decoration: none;
  }
  .mm-link:hover { color: var(--color-accent); }
  .mm-channels { display: grid; gap: var(--s-1); }
  .mm-channel { display: flex; align-items: center; gap: var(--s-2); min-height: 52px; font-weight: 600; font-size: var(--fs-md); text-decoration: none; color: var(--color-accent); }
  .mm-channel :global(svg) { width: 22px; height: 22px; }
  .mm-future { display: grid; gap: var(--s-1); color: var(--color-muted); font-size: var(--fs-sm); }
  .mm-future ul { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  @media (min-width: 1200px) { .mobile-menu { display: none !important; } }
</style>
