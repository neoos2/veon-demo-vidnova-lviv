---
// Client photo → AVIF/WebP + srcset (astro:assets). width/height come from the source, so no layout shift.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  src: ImageMetadata; alt: string; sizes: string; widths?: number[];
  eager?: boolean; class?: string; pictureClass?: string;
}
const { src, alt, sizes, widths = [480, 800, 1200], eager = false, class: cls, pictureClass } = Astro.props;
const usable = widths.filter((w) => w <= src.width);
---
<Picture
  src={src}
  alt={alt}
  formats={["avif", "webp"]}
  fallbackFormat="jpg"
  widths={usable.length ? usable : [src.width]}
  sizes={sizes}
  quality={72}
  loading={eager ? "eager" : "lazy"}
  decoding={eager ? "sync" : "async"}
  fetchpriority={eager ? "high" : undefined}
  class={cls}
  pictureAttributes={{ class: pictureClass }}
/>
